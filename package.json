{
  "name": "claude-persian-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Persian font & RTL plugin for Claude Desktop and Claude Code",
  "license": "MIT",
  "author": "hosseinhabibi2004",
  "repository": "github:hosseinhabibi2004/claude-persian-kit",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test:unit": "node --test \"plugins/*/tests/*.unit.ts\" \"patcher/test/*.test.js\"",
    "test:mods": "node scripts/run-mod-tests.mjs",
    "validate": "node scripts/validate-all.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "sync": "node scripts/sync-assets.mjs",
    "sync:check": "node scripts/sync-assets.mjs --check"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.1",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3"
  }
}
